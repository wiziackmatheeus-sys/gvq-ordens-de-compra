rules_version = '2';
// As permissões de verdade ficam aqui: esconder abas na tela não protege nada.
// Cada cadastro fica em usuarios/{login}. O login vem do e-mail interno da conta
// (login@gvq.com.br), que o Firebase garante ser único.
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null && request.auth.token.email.matches('^[a-z0-9][a-z0-9._-]{2,59}@gvq[.]com[.]br$'); }
    function meuLogin() { return request.auth.token.email.split('@')[0]; }
    function caminho(colecao, id) { return /databases/$(database)/documents/$(colecao)/$(id); }
    function eu() { return get(caminho('usuarios', meuLogin())).data; }
    function ativo() {
      return logado() && exists(caminho('usuarios', meuLogin()))
        && eu().uid == request.auth.uid && eu().perfil in ['solicitante', 'analista'] && eu().get('ativo', true) == true;
    }
    // Cargo Master: fixo por login (mesma lista de MASTERS em js/listas.js). Faz tudo o que o
    // analista faz e é o único que muda o cargo ou desativa outras pessoas.
    function loginsMaster() { return ['matheus.souza', 'matheus.silveira']; }
    function master() { return ativo() && meuLogin() in loginsMaster(); }
    function analista() { return ativo() && (eu().perfil == 'analista' || meuLogin() in loginsMaster()); }

    function texto(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function camposFormulario() {
      return ['tipo', 'sexo', 'raca', 'quantidade', 'origem', 'destino', 'proprietario', 'dataPrevista',
        'preco', 'observacao', 'telefone', 'solicitante', 'responsavel'];
    }
    function formularioValido(d) {
      return d.tipo in ['Compra', 'Transferência', 'Trading']
        && d.sexo in ['Machos', 'Fêmeas']
        && d.proprietario in ['Grupo', 'Núcleo IQ']
        && texto(d.raca, 1, 100) && d.quantidade is int && d.quantidade > 0 && d.quantidade <= 100000
        && texto(d.origem, 1, 200) && texto(d.destino, 1, 200) && texto(d.dataPrevista, 10, 10)
        && texto(d.solicitante, 1, 120) && texto(d.responsavel, 1, 120)
        && texto(d.telefone, 0, 40) && texto(d.observacao, 0, 2000)
        // O preço só existe em Compra.
        && ((d.tipo == 'Compra' && d.preco is number && d.preco > 0) || (d.tipo != 'Compra' && d.preco == null));
    }
    function assinaturaAnalise(d) {
      return d.analisadoPor == meuLogin() && d.analisadoPorNome == eu().nome && d.analisadoEm == request.time;
    }

    match /usuarios/{login} {
      allow read: if (logado() && login == meuLogin()) || analista();
      // Quem cria o próprio acesso começa sempre como solicitante ativo.
      allow create: if logado() && login == meuLogin()
        && request.resource.data.keys().hasOnly(['nome', 'uid', 'perfil', 'ativo', 'criadoEm'])
        && texto(request.resource.data.nome, 1, 100) && request.resource.data.uid == request.auth.uid
        && request.resource.data.perfil == 'solicitante' && request.resource.data.ativo == true
        && request.resource.data.criadoEm == request.time;
      allow update: if
        // Acesso recriado depois de esquecer a senha: só troca a conta vinculada; perfil e
        // situação continuam (um acesso desativado continua desativado).
        (logado() && login == meuLogin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'recriadoEm'])
          && request.resource.data.uid == request.auth.uid && request.resource.data.recriadoEm == request.time)
        // Só o Master muda cargo (Solicitante/Analista) e situação, e nunca de outro Master.
        || (master() && !(login in loginsMaster())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['perfil', 'ativo'])
          && request.resource.data.perfil in ['solicitante', 'analista']
          && request.resource.data.get('ativo', true) is bool);
      allow delete: if false;
    }

    match /listas/{nome} {
      allow read: if ativo();
      allow write: if analista() && nome in ['fazendas', 'origens', 'racas', 'responsaveis']
        && request.resource.data.keys().hasOnly(['itens', 'atualizadoPor', 'atualizadoEm'])
        && request.resource.data.itens is list && request.resource.data.itens.size() <= 3000
        && request.resource.data.atualizadoPor == meuLogin();
    }

    match /solicitacoes/{id} {
      allow read: if analista() || (ativo() && resource.data.criadoPor == meuLogin());

      allow create: if ativo()
        && request.resource.data.keys().hasOnly(camposFormulario().concat(['status', 'mensagemAnalista', 'criadoPor', 'criadoPorNome', 'criadoEm', 'atualizadoEm']))
        && formularioValido(request.resource.data)
        && request.resource.data.status == 'aguardando' && request.resource.data.mensagemAnalista == ''
        && request.resource.data.criadoPor == meuLogin() && request.resource.data.criadoPorNome == eu().nome
        && request.resource.data.criadoEm == request.time && request.resource.data.atualizadoEm == request.time;

      allow update: if
        // Solicitante corrige um pedido devolvido para ajuste e reenvia.
        (ativo() && resource.data.criadoPor == meuLogin() && resource.data.status == 'ajuste'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(camposFormulario().concat(['status', 'atualizadoEm']))
          && request.resource.data.status == 'aguardando' && request.resource.data.atualizadoEm == request.time
          && formularioValido(request.resource.data))
        // Solicitante cancela o próprio pedido enquanto ainda não virou OC.
        || (ativo() && resource.data.criadoPor == meuLogin() && resource.data.status in ['aguardando', 'ajuste']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'atualizadoEm'])
          && request.resource.data.status == 'cancelada' && request.resource.data.atualizadoEm == request.time)
        // Analista pede ajuste ou recusa, sempre com mensagem.
        || (analista() && resource.data.status == 'aguardando'
          && request.resource.data.status in ['ajuste', 'recusada']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'mensagemAnalista', 'analisadoPor', 'analisadoPorNome', 'analisadoEm'])
          && texto(request.resource.data.mensagemAnalista, 1, 1000) && assinaturaAnalise(request.resource.data))
        // Analista gera a OC: só junto com a criação da própria OC, na mesma transação.
        || (analista() && resource.data.status == 'aguardando' && request.resource.data.status == 'gerada'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'ocNumero', 'mensagemAnalista', 'analisadoPor', 'analisadoPorNome', 'analisadoEm'])
          && request.resource.data.ocNumero is int && assinaturaAnalise(request.resource.data)
          && !exists(caminho('ocs', string(request.resource.data.ocNumero)))
          && getAfter(caminho('ocs', string(request.resource.data.ocNumero))).data.solicitacaoId == id);
      allow delete: if false;
    }

    match /ocs/{numero} {
      allow read: if analista() || (ativo() && resource.data.criadoPor == meuLogin());

      // Número automático: é o próximo livre do contador, que avança na mesma transação.
      allow create: if analista()
        && request.resource.data.keys().hasOnly(['numero', 'dataEmissao', 'status', 'viabilidade', 'trava', 'tipo', 'sexo', 'raca', 'quantidade', 'origens',
          'destino', 'proprietario', 'dataPrevista', 'observacao', 'telefone', 'solicitante', 'responsavel',
          'criadoPor', 'solicitacaoId', 'geradaPor', 'geradaPorNome', 'geradaEm'])
        && request.resource.data.numero is int && string(request.resource.data.numero) == numero
        && request.resource.data.numero >= get(caminho('config', 'contador')).data.proxima
        && getAfter(caminho('config', 'contador')).data.proxima == request.resource.data.numero + 1
        && request.resource.data.status == 'Em Andamento' && request.resource.data.viabilidade == 'Pendente'
        && request.resource.data.trava in ['Sim', 'Não']
        && request.resource.data.quantidade is int && request.resource.data.quantidade > 0
        && request.resource.data.origens is list && request.resource.data.origens.size() >= 1 && request.resource.data.origens.size() <= 50
        && request.resource.data.geradaPor == meuLogin() && request.resource.data.geradaEm == request.time
        && getAfter(caminho('solicitacoes', request.resource.data.solicitacaoId)).data.ocNumero == request.resource.data.numero;

      // Carga das OCs da planilha antiga (aba Cadastros): só números anteriores ao contador.
      allow create: if analista() && request.resource.data.fonte == 'planilha'
        && request.resource.data.keys().hasOnly(['fonte', 'numero', 'rotulo', 'status', 'tipo', 'sexo', 'raca', 'quantidade', 'origens',
          'destino', 'proprietario', 'dataPrevista', 'trava', 'alerta', 'importadaPor', 'importadaEm'])
        && request.resource.data.numero is int && request.resource.data.numero < get(caminho('config', 'contador')).data.proxima
        && request.resource.data.status in ['Pendente', 'Aberto', 'Finalizado', 'Cancelado']
        && request.resource.data.origens is list && request.resource.data.origens.size() <= 50
        && request.resource.data.importadaPor == meuLogin() && request.resource.data.importadaEm == request.time;

      // OCs antigas ainda podem estar como Pendente ou Aberto (= Em Andamento) e sem viabilidade.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'viabilidade', 'statusAtualizadoPor', 'statusAtualizadoPorNome', 'statusAtualizadoEm'])
        && request.resource.data.statusAtualizadoPor == meuLogin() && request.resource.data.statusAtualizadoEm == request.time
        && (
          // Analista ou Master muda status e viabilidade, inclusive para Cancelado.
          (analista() && request.resource.data.status in ['Em Andamento', 'Finalizado', 'Cancelado']
            && request.resource.data.get('viabilidade', '') in ['Pendente', 'Concluída'])
          // Solicitante só cancela a OC do próprio pedido, enquanto Em Andamento.
          || (ativo() && resource.data.get('criadoPor', '') == meuLogin()
            && resource.data.status in ['Em Andamento', 'Pendente', 'Aberto'] && request.resource.data.status == 'Cancelado'
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['viabilidade']))
        );
      allow delete: if false;
    }

    match /config/contador {
      allow read: if analista();
      allow update: if analista()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proxima'])
        && request.resource.data.proxima is int && request.resource.data.proxima > resource.data.proxima
        && !exists(caminho('ocs', string(request.resource.data.proxima - 1)))
        && existsAfter(caminho('ocs', string(request.resource.data.proxima - 1)));
      allow create, delete: if false;
    }
  }
}
